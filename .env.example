# Obligatorio: tu key de https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Opcional: modelo de OpenRouter (tiene que soportar tool calling)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Opcional: clave para entrar al panel (/panel?clave=...)
PANEL_PASSWORD=
# Opcional: para guardar solicitudes en Upstash Redis (recomendado en Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
