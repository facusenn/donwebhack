# Obligatorio uno de los dos: key de https://openrouter.ai/keys o de https://build.nvidia.com
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Opcional: modelo de OpenRouter (tiene que soportar tool calling)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Opcional: clave para entrar al panel (/panel?clave=...)
PANEL_PASSWORD=
# Opcional: para guardar solicitudes en Upstash Redis (recomendado en Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: transcripción de "Escuchar consulta" (si la key de arriba no es de OpenAI)
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-transcribe
# Opcional: mandar por WhatsApp los pedidos pendientes (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
